{
  "cli": {
    "version": ">= 16.9.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.19.4",
      "android": {
        "image": "latest"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://xmwhhvqdonnkdsnheyoq.supabase.co",
        "EXPO_PUBLIC_API_BASE": "https://avoid.net"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "https://xmwhhvqdonnkdsnheyoq.supabase.co",
        "EXPO_PUBLIC_API_BASE": "https://avoid.net"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "release-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
