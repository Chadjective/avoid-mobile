# Public API base for the AVOID.NET web app. Defaults to https://avoid.net
# when unset. Point it at a laptop for local work, e.g. http://10.0.2.2:3000
# (10.0.2.2 is the host machine as seen from the Android emulator).
EXPO_PUBLIC_API_BASE=https://avoid.net

# Supabase project the app authenticates against. These are the SAME public
# values the web app ships in NEXT_PUBLIC_SUPABASE_URL / _ANON_KEY. The
# service key never appears in a client app.
#
# THIS FILE IS FOR LOCAL BUILDS ONLY. An EAS build never uploads it: the URL
# and the API base live in eas.json's `env` block, and the anon key comes from
# an EAS project environment variable named EXPO_PUBLIC_SUPABASE_ANON_KEY
# (expo.dev -> Project -> Environment variables, Plain text, preview +
# production). See README "Where the build gets its keys". Sign-in was dead in
# the first Seeker build because these were set here and nowhere else.
EXPO_PUBLIC_SUPABASE_URL=https://xmwhhvqdonnkdsnheyoq.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Solana cluster the app reads anchors from and countersigns on.
# 'mainnet-beta' | 'devnet' | 'testnet' (docs/MOBILE_APP_SPEC.md D5).
EXPO_PUBLIC_SOLANA_CLUSTER=mainnet-beta
EXPO_PUBLIC_SOLANA_RPC_URL=
