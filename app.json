{
  "expo": {
    "name": "AVOID.NET",
    "slug": "avoid-mobile",
    "owner": "chadjective",
    "version": "0.2.7",
    "orientation": "portrait",
    "scheme": "avoid",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "icon": "./assets/icon.png",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "net.avoid.mobile",
      "userInterfaceStyle": "dark",
      "backgroundColor": "#0a0a0a",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "avoid"
            }
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#ededed"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "488ed609-cffd-42ed-8571-048ce5705b2e"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/488ed609-cffd-42ed-8571-048ce5705b2e",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
